# Copy to .env and fill in for real SMTP. If SMTP_HOST is empty or SMTP_MOCK=true,
# the app uses mock mode (logs only, marks mail as sent after a short delay).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use STARTTLS on connect (typical for port 587)
SMTP_USE_TLS=true

# Force mock mode even when SMTP_HOST is set (optional)
SMTP_MOCK=false
